{
  "name": "location-intelligence",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev:web": "pnpm --filter @location-intelligence/web dev",
    "build:web": "pnpm --filter @location-intelligence/web build",
    "lint:web": "pnpm --filter @location-intelligence/web lint",
    "test:web": "pnpm --filter @location-intelligence/web test",
    "test:e2e": "pnpm --filter @location-intelligence/web test:e2e",
    "test:e2e:smoke": "pnpm --filter @location-intelligence/web test:e2e:smoke",
    "test:e2e:critical": "pnpm --filter @location-intelligence/web test:e2e:critical",
    "test:e2e:regression": "pnpm --filter @location-intelligence/web test:e2e:regression",
    "test:e2e:production-smoke": "pnpm --filter @location-intelligence/web test:e2e:production-smoke",
    "test:e2e:ui": "pnpm --filter @location-intelligence/web test:e2e:ui",
    "generate:types": "pnpm --filter @location-intelligence/web generate:types",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.4.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.0",
      "nanoid": "^3.3.17"
    }
  }
}
