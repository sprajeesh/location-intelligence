# ─── Docker build ───
# For local dev, set these yourself (any values work). In production, this
# whole .env file is generated on the app VM by scripts/fetch-secrets.sh from
# the DB_USER/DB_PASSWORD GitHub secrets at deploy time. Nothing here is used in prod.
DB_USER=gisuser
DB_PASSWORD=changeme

# ─── Backend ───
# Only scripts/fetch-secrets.sh's generated prod .env sets ENVIRONMENT=production
# -- leave unset here. When it's "production", startup fails unless
# API_SHARED_SECRET below is also set (see apps/api/app/config/settings.py).
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql://gisuser:changeme@localhost:5432/gis
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_MAX_CONCURRENCY=2
OSRM_URL=http://localhost:5000
# Local Redis runs with no auth (docker-compose.yml's redis service has no
# --requirepass) -- it's bound to 127.0.0.1 only, so this is fine for local
# dev. Only production's Redis (docker-compose.prod.yml overlay) requires a
# password, sourced from the REDIS_PASSWORD GitHub secret via
# scripts/fetch-secrets.sh; nothing here is used in prod.
REDIS_URL=redis://localhost:6379

# Scoring (tunable)
SCORING_ALPHA=0.6
SCORING_BETA=0.4
SCORING_DENSITY_FACTOR=10

# Shared secret the Next.js BFF sends as X-Internal-Api-Key (see
# apps/api/app/api/deps.py). Leave unset for local dev -- the API only
# enforces this when it's non-empty. In production it's set from the
# API_SHARED_SECRET GitHub secret on both ends (VM .env and the Cloudflare
# Worker via `wrangler secret put`).
API_SHARED_SECRET=

# ─── Frontend ───
# In production this must be an HTTPS URL on a real hostname pointed at the
# app VM (e.g. https://api.example.com), not a bare IP over plain HTTP.
# The browser never calls this URL directly -- it's only read server-side
# inside Next.js Route Handlers (apps/web/src/app/api/*/route.ts) that proxy
# to the API -- but Cloudflare-to-VM traffic still crosses the public
# internet, so it must be encrypted in transit: plain HTTP would expose the
# X-Internal-Api-Key shared secret and response data to anyone on-path
# between Cloudflare and the VM. TLS can't be issued for a bare IP, so this
# requires a DNS hostname plus a reverse proxy (e.g. Caddy/nginx) on the VM
# terminating TLS in front of the API container.
NEXT_PUBLIC_API_URL=http://localhost:8000
