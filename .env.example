# ─── Docker build ───
# For local dev, set these yourself (any values work). In production, this
# whole .env file is generated on the app VM by scripts/fetch-secrets.sh from
# the DB_USER/DB_PASSWORD GitHub secrets at deploy time. Nothing here is used in prod.
DB_USER=gisuser
DB_PASSWORD=changeme

# ─── Backend ───
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql://gisuser:changeme@localhost:5432/gis
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_MAX_CONCURRENCY=2
OSRM_URL=http://localhost:5000
REDIS_URL=redis://localhost:6379

# Scoring (tunable)
SCORING_ALPHA=0.6
SCORING_BETA=0.4
SCORING_DENSITY_FACTOR=10

# Shared secret the Next.js BFF sends as X-Internal-Api-Key (see
# apps/api/app/api/deps.py). Leave unset for local dev -- the API only
# enforces this when it's non-empty. In production it's set from the
# API_SHARED_SECRET GitHub secret on both ends (VM .env and the Cloudflare
# Worker via `wrangler secret put`).
API_SHARED_SECRET=

# ─── Frontend ───
# In production this points at the app VM's public IP over plain HTTP
# (e.g. http://<vm-ip>:8000). This is safe here despite the app being
# served over HTTPS on Cloudflare: the browser never calls this URL
# directly, it's only read server-side inside Next.js Route Handlers
# (apps/web/src/app/api/*/route.ts) that proxy to the API. No mixed-content
# issue, so no reverse proxy/TLS is needed on the API for this demo.
NEXT_PUBLIC_API_URL=http://localhost:8000
